# ─── LLM Provider ─────────────────────────────────────────────
# Option A: Ollama (local, free)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# Option B: Groq (cloud, free tier)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_key_here

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_gemini_api_key_here_placeholder_gemini_api_key00
GEMINI_API_KEY=your_gemini_api_key_here_placeholder_gemini_api_key00

# ─── RAG Service ──────────────────────────────────────────────
RAG_SERVICE_URL=http://localhost:8000

# ─── Server ───────────────────────────────────────────────────
PORT=3000

